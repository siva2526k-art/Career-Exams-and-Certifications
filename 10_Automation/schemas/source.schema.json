{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceRecord",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "domain_type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "domain_type": {
      "type": "string",
      "enum": [
        "Government",
        "Academic",
        "Vendor_Official",
        "Gazette",
        "International_Body"
      ]
    },
    "last_accessed": {
      "type": "string"
    }
  }
}