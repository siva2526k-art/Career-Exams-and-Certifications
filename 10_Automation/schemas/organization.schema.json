{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganizationRecord",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "headquarters",
    "official_website"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "headquarters": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "official_website": {
      "type": "string",
      "format": "uri"
    },
    "portal": {
      "type": "string"
    }
  }
}